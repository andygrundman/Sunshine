#version 450

// RGB -> YUV420P/YUV444P with aspect-preserving scale + letterbox + optional flip.
// One dispatch over the luma output grid; for 4:2:0 the even invocations also write the
// subsampled chroma, for 4:4:4 every invocation writes full-resolution chroma.
//
// Color math:
//  - SDR (pc.hdr == 0): BT.601 limited range on sRGB-encoded R'G'B' (8- or 16-bit containers).
//  - HDR (pc.hdr == 1): BT.2020 non-constant-luminance FULL range on PQ-encoded R'G'B'
//    (10-bit profile, 16-bit containers; full range sidesteps depth-dependent limited-range
//    scaling and both ends of this codec path are ours).
//
// Plane images are declared without a format qualifier (writeonly) so the same pipeline binds
// R8_UNORM or R16_UNORM views; requires shaderStorageImageWriteWithoutFormat (any desktop GPU).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_src;           // captured RGB (linear sampler)
layout(set = 0, binding = 1) uniform writeonly image2D u_y;     // luma  (dst.x  x dst.y)
layout(set = 0, binding = 2) uniform writeonly image2D u_cb;    // chroma (dst.x/2 x dst.y/2, or dst.x x dst.y for 4:4:4)
layout(set = 0, binding = 3) uniform writeonly image2D u_cr;

layout(push_constant) uniform PC {
    ivec2 dst;      // luma output size
    ivec2 scaled;   // aspect-fit content size within dst (even)
    ivec2 offset;   // letterbox offset (even)
    int   flip;     // 1 => sample source bottom-up
    int   chroma444; // 1 => full-resolution chroma (4:4:4), 0 => 2x2-subsampled (4:2:0)
    int   hdr;      // 1 => BT.2020 NCL full-range PQ, 0 => BT.601 limited sRGB
} pc;

// BT.601 limited range
const vec3 kY  = vec3( 0.256788,  0.504129,  0.097906);
const vec3 kCb = vec3(-0.148223, -0.290993,  0.439216);
const vec3 kCr = vec3( 0.439216, -0.367788, -0.071427);
const float Y_BIAS = 16.0 / 255.0;
const float C_BIAS = 128.0 / 255.0;

// BT.2020 non-constant luminance (applied to PQ-encoded R'G'B'), full range
const vec3 kY2020 = vec3(0.2627, 0.6780, 0.0593);

vec3 sample_rgb(ivec2 act) {
    vec2 uv = (vec2(act) + 0.5) / vec2(pc.scaled);
    if (pc.flip != 0) {
        uv.y = 1.0 - uv.y;
    }
    return texture(u_src, uv).rgb;
}

float luma_of(vec3 rgb) {
    if (pc.hdr != 0) {
        return dot(kY2020, rgb);
    }
    return dot(kY, rgb) + Y_BIAS;
}

// Letterbox fill: black at the correct code point for the active convention.
float luma_fill() {
    return pc.hdr != 0 ? 0.0 : Y_BIAS;
}

vec2 chroma_of(vec3 rgb) {
    if (pc.hdr != 0) {
        float y = dot(kY2020, rgb);
        return vec2((rgb.b - y) / 1.8814, (rgb.r - y) / 1.4746) + 0.5;
    }
    return vec2(dot(kCb, rgb), dot(kCr, rgb)) + C_BIAS;
}

vec2 chroma_fill() {
    return pc.hdr != 0 ? vec2(0.5) : vec2(C_BIAS);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.dst.x || p.y >= pc.dst.y) {
        return;
    }

    ivec2 a = p - pc.offset;
    bool inside = a.x >= 0 && a.x < pc.scaled.x && a.y >= 0 && a.y < pc.scaled.y;

    vec3 rgb = inside ? sample_rgb(a) : vec3(0.0);

    imageStore(u_y, p, vec4(inside ? luma_of(rgb) : luma_fill()));

    if (pc.chroma444 != 0) {
        // 4:4:4: co-sited full-resolution chroma from the same sample as luma.
        vec2 c = inside ? chroma_of(rgb) : chroma_fill();
        imageStore(u_cb, p, vec4(c.x));
        imageStore(u_cr, p, vec4(c.y));
    }
    else if ((p.x & 1) == 0 && (p.y & 1) == 0) {
        // Box-filter RGB over the 2x2 luma block for proper 4:2:0 chroma instead of point-sampling
        // the top-left texel, which aliases and color-fringes edges (e.g. text).
        vec3 sum = vec3(0.0);
        float n = 0.0;
        for (int dy = 0; dy < 2; dy++) {
            for (int dx = 0; dx < 2; dx++) {
                ivec2 aa = a + ivec2(dx, dy);
                if (aa.x >= 0 && aa.x < pc.scaled.x && aa.y >= 0 && aa.y < pc.scaled.y) {
                    sum += sample_rgb(aa);
                    n += 1.0;
                }
            }
        }
        vec2 c = n > 0.0 ? chroma_of(sum / n) : chroma_fill();
        ivec2 cp = p >> 1;
        imageStore(u_cb, cp, vec4(c.x));
        imageStore(u_cr, cp, vec4(c.y));
    }
}
